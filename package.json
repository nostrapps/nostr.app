{
  "name": "nostr-app",
  "version": "0.0.8",
  "description": "nostr app",
  "main": "main.js",
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "echo \"Error: no test specified\" && exit 1",
    "serve": "node ./bin/serve.js",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "bin": {
    "nostr-app": "./bin/serve.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nostrapps/nostr.app.git"
  },
  "keywords": [
    "nostr"
  ],
  "author": "Melvin Carvalho",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/nostrapps/nostr.app/issues"
  },
  "homepage": "https://github.com/nostrapps/nostr.app#readme",
  "dependencies": {
    "fs": "^0.0.1-security",
    "http": "^0.0.1-security",
    "path": "^0.12.7",
    "url": "^0.11.4"
  },
  "devDependencies": {
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.nostr.app",
    "productName": "Nostr.App",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.utilities"
    },
    "linux": {
      "category": "Utility"
    },
    "win": {
      "target": "portable"
    }
  }
}
